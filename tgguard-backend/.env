PORT=5000
NODE_ENV=production

# MongoDB Atlas (free tier - 512MB storage)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tgguard?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=TGGuardBot
OWNER_TELEGRAM_ID=your-telegram-user-id

# Frontend URL (Render will give you this)
FRONTEND_URL=https://your-frontend.onrender.com
